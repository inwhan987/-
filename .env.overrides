# 깃에 커밋되는 튜닝 값 (시크릿 금지!)
# docker compose 가 .env 뒤에 이 파일을 로드해서 같은 키는 덮어씀.
# 여기 값을 바꾸고 push → 파이에서 git pull → docker compose up -d 하면 반영.

# ── 거래 실행 모드 ───────────────────────────────────────────────────────────
TRADE_DRY_RUN=true

# ── 캔들 & 실행 주기 ─────────────────────────────────────────────────────────
LIVE_CANDLE=minute
LIVE_INTERVAL_MINUTES=5
LIVE_CANDLE_MINUTES=5
NEWS_PAGES_PER_SYMBOL=2

# ── 앙상블 구성 (4 주력 균등 + DailyContext 최소 안전장치) ──
ENSEMBLE_WEIGHTS=0.25,0.22,0.20,0.18,0.15
ENSEMBLE_MIN_BUY_VOTES=2
ENSEMBLE_BUY_THRESHOLD=0.55
ENSEMBLE_MIN_SELL_VOTES=2
ENSEMBLE_SELL_THRESHOLD=-0.55

# ── 추가매수 설정 ────────────────────────────────────────────────────────────
ADD_BUY_ENABLED=false
ADD_BUY_THRESHOLD=0.45
ADD_BUY_MIN_VOTES=2
ADD_BUY_MAX_COUNT=2
ADD_BUY_FRACTION=0.2
ADD_BUY_MAX_POSITION_PCT=0.8
ADD_BUY_REQUIRE_TREND_AGREE=true
ADD_BUY_INHERIT_INITIAL_STOP=true

# ── 손절 후 재진입 쿨다운 ────────────────────────────────────────────────────
POST_STOPLOSS_COOLDOWN_MIN=120

# ── 엔진 하드 손절 ───────────────────────────────────────────────────────────
ENGINE_HARD_STOP_ENABLED=true

# ── 일일 최대 손실 한도 ──────────────────────────────────────────────────────
DAILY_MAX_LOSS_PCT=0

# ── DailyContext (오버나이트 청산) ────────────────────────────────────────────
OVERNIGHT_SELL_THRESHOLD=-0.20
OVERNIGHT_MIN_SELL_VOTES=1
DAILY_CONTEXT_PROFIT_GATE_PCT=1.5
DAILY_CONTEXT_AVWAP_PCT=1.5
DAILY_CONTEXT_PDH_PCT=1.0
DAILY_CONTEXT_PDC_PCT=2.0
DAILY_CONTEXT_TREND_BONUS=0.5

# ── VWAP 파라미터 ─────────────────────────────────────────────────────────────
TRADE_VWAP_BAND=0.007
TRADE_VWAP_SELL_BAND=0.0085
TRADE_VWAP_ST_BULL_SELL_BAND=0.009
TRADE_VWAP_WARMUP_BARS=8

# ── RSI 파라미터 ─────────────────────────────────────────────────────────────
TRADE_RSI_PERIOD=20
TRADE_RSI_OVERSOLD=30
TRADE_RSI_OVERBOUGHT=74.0

# ── Bollinger Band 파라미터 ──────────────────────────────────────────────────
TRADE_BB_WINDOW=20
TRADE_BB_K=2.0
TRADE_BB_CONSEC=3

# ── Supertrend 파라미터 ──────────────────────────────────────────────────────
TRADE_SUPERTREND_PERIOD=7
TRADE_SUPERTREND_MULT=3.0

# ── 포지션 사이징 ─────────────────────────────────────────────────────────────
POSITION_SIZING=fraction
POSITION_FRACTION=0.5

# ── ATR 동적 손절 ─────────────────────────────────────────────────────────────
ATR_STOP_LOSS_ENABLED=true
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=5
ATR_STOP_MAX_PCT=4

# ── 시간대 차단 ──────────────────────────────────────────────────────────────
ENTRY_BLOCK_ENABLED=true
ENTRY_BLOCK_START=09:00
ENTRY_BLOCK_END=09:40
ENTRY_BLOCK_MIN_PROFIT_TO_SELL_PCT=2.0
ENTRY_BLOCK_FORCE_SELL_FRACTION=0.5
CLOSE_BLOCK_ENABLED=true
CLOSE_BLOCK_START=15:00

# ── 거래량 필터 ──────────────────────────────────────────────────────────────
ENSEMBLE_VOLUME_FILTER_ENABLED=true
ENSEMBLE_VOLUME_MA_PERIOD=25
ENSEMBLE_VOLUME_HIGH_RATIO=1.2
ENSEMBLE_VOLUME_LOW_RATIO=0.7
ENSEMBLE_VOLUME_SCORE_BOOST=0.10
ENSEMBLE_VOLUME_SCORE_PENALTY=0.05

# ── 뉴스 veto ────────────────────────────────────────────────────────────────
ENSEMBLE_NEWS_VETO_THRESHOLD=-0.6
ENSEMBLE_NEWS_STRONG_NEG_RATIO=0.10

# ── Claude API 예산 ───────────────────────────────────────────────────────────
API_BUDGET_USD=5.0

# ── 뉴스 LLM 감성분석 ────────────────────────────────────────────────────────
# 2026-07-05: claude_code(구독) 전환으로 비용 0 → 뉴스 감성 LLM 재사용 (사용자 지시)
NEWS_PREFER_LLM=true

# ── 백테스트 내부 옵션 ───────────────────────────────────────────────────────
SELL_ON_NEXT_OPEN=true

# ── 성과 측정 ────────────────────────────────────────────────────────────────
INITIAL_CAPITAL_KRW=100000000
STOCK_CAPITAL_KRW=50000000
LEADER_CAPITAL_KRW=50000000
PERF_START_DATE=2026-04-27
TRADE_FEE_BUY_PCT=0.00015
TRADE_FEE_SELL_PCT=0.00195

# ── 스크리너 ────────────────────────────────────────────────────────────────
SCREENER_SECTOR=건설
SCREENER_TOP_N=2
SYMBOLS=006360,013580

# ── 원격(CI) 스코어링 오프로드 (파이 OOM 대책) ──
# ON 이면 무거운 스코어링(③)을 GitHub Actions(screener-run.yml)로 넘기고, CI가 stdout 을
# 중계 gist 에 누적 PATCH → 파이가 gist 를 ~2초 폴링해 실시간 수신(터널 불필요). 섹터선정·
# 검수·SYMBOLS 기록은 파이가 그대로 처리(로컬 실행과 저장·로그 100% 동형).
# 아래 토글만 여기(비밀 아님)에 두고, PAT 는 반드시 .env 에:
#   SCREENER_GH_TOKEN = GitHub PAT (workflow 디스패치 + 중계 gist 생성/폴링 → repo·workflow·gist 스코프)
#   레포 시크릿 SCREENER_GIST_TOKEN = CI가 gist 에 쓰기용 (위 PAT 와 동일값 가능)
#   (선택) SCREENER_CI_REPO=inwhan987/- · SCREENER_CI_REF=main · SCREENER_CI_WORKFLOW=screener-run.yml
# PAT 없으면 자동으로 로컬 실행으로 폴백. 설정법: CI_SCREENER_SETUP.md
SCREENER_REMOTE_ENABLED=true

# ── 분할 익절 ────────────────────────────────────────────────────────────────
TAKE_PROFIT_ENABLED=true
TAKE_PROFIT_PCT=5
TAKE_PROFIT_FRACTION=0.5
SCREENER_AUTO_SECTOR=true
SCREENER_DOWNTREND_HALVE=false

# ── 장전 Claude 검수 (모델은 premarket_review.MODEL 상수 참조) ──
# 섹터분석 결과를 Claude가 검수해 부적합 시 랭킹 차순위로 자동 전환하고,
# 스크리너 선별 종목도 벤치 내에서 검수·교체한다. OFF면 순수 알고리즘.
SCREENER_LLM_REVIEW_ENABLED=true
# 섹터 검수 시 밤사이 글로벌(SOX·미국장·환율)·국내 공시/시황을 웹서치로 참고.
# 선택 범위는 랭킹 내 eligible로 고정. OFF면 숫자만으로 검수.
SCREENER_REVIEW_WEBSEARCH=true
SCREENER_RS_DAYS=20
SCREENER_MIN_STOCKS=5
# 분석 유니버스: 코스피·코스닥 각 시총 상위 N (0=전체). 1000 ≈ 코스피 전량+코스닥 상위 2/3
SCREENER_MARKET_TOP=800
# 네이버 스크래핑 전역 분당 요청 상한 (차단 방지). 403/429 보이면 60으로 낮출 것
SCREENER_NAVER_RPM=80
# 유니버스 자격 필터(점수 무영향, 픽 자격만 하드컷). 급등주는 봇 수익원이라 배제 안 함.
# 신규상장: 일봉 이력 N거래일 미만 배제(검증불가·짧은이력). 60=~3개월.
SCREENER_MIN_LISTING_DAYS=60
# 거래대금: 20일평균 N억 미만 배제(체결 안정성). 30=기존 '얇음' 태그 기준.
SCREENER_MIN_TURNOVER_EOK=30
# 시총: KRX 시총 N억 미만 초소형 배제(슬리피지 보조컷).
SCREENER_MIN_CAP_EOK=300
LEADER_TRADE_ENABLED=true
LEADER_BUDGET_KRW=50000000
LEADER_MAX_POSITIONS=1
LEADER_SLOT_BUDGET_KRW=0.0
LEADER_INTERVAL_MIN=3
LEADER_W=2
LEADER_STOP_BUF_PCT=1.5
LEADER_TP_PCT=4.0
LEADER_MAX_PULL_PCT=5.0
LEADER_RECLAIM=true
LEADER_BAR_RANGE_PCT=1.5
LEADER_CLOSE_TIME=14:55
LEADER_OWN_SYMBOL_PRIORITY=true
ACCOUNT_SIZE_KRW=50000000

# ── 약세장 차단 (지수 레짐) ──────────────────────────────────────────────────
REGIME_BLOCK_ENABLED=true

# ── 종목 일봉 게이트 (개별 종목 하락추세 시 신규 미진입) ─────────────────────
# 그 종목 자신의 일봉이 MA아래 & MA가 가파른 하락이면 신규 BUY 차단 (지수와 별개).
STOCK_DAILY_GATE_ENABLED=true
STOCK_DAILY_GATE_MA=20
STOCK_DAILY_GATE_SLOPE_DAYS=5
STOCK_DAILY_GATE_SLOPE_PCT=1.0

# ── LLM 백엔드 & 기능별 모델 (2026-07-05 claude_code 구독 전환, 사용료 0) ──
# api=기존 anthropic SDK(롤백용) / claude_code=Claude Code CLI 구독 호출.
# 모델은 api·claude_code 양쪽 다 아래 3개 값을 따른다(별칭 opus/sonnet/haiku/fable).
LLM_BACKEND=claude_code
PREMARKET_REVIEW_MODEL=opus
DAILY_REVIEW_MODEL=opus
NEWS_SENTIMENT_MODEL=opus
# api 백엔드 예산 창 리셋 시각(epoch). claude_code에선 명목값.
API_BUDGET_RESET_AT=1783229943
LEADER_SWITCH_ENABLED=true

# ── 파이 웹 동기화 신규 파라미터 (2026-08-12 파이 실값 재동기화, 수급 삭제 후속) ──
LEADER_SEL_RISE_MIN=5
LEADER_PHWIN_MIN=30
LEADER_ANCHOR=vwap
LEADER_ANCHOR_TOL=0.3
LEADER_SWITCH_INTERVAL_MIN=5
LEADER_SEL_MIN_CAP_EOK=1000.0
LEADER_BAND_RATIO=0.6
LEAD_SC_W_BREADTH=0.35
LEADER_SEL_TURNOVER_CAP_PCT=200.0
LEADER_SEL_HOT_MIN=3
LEAD_ST_W_VALUE=0.2
LEADER_SWITCH_UNTIL=13:00
LEADER_VWAP_TOL=0.3
LEADER_SEL_MAX_CHANGE=25.0
LEADER_SEL_MIN_VALUE_EOK=500.0
LEADER_SEL_MIN_VALUE_ANCHOR_HHMM=11:00
LEADER_SEL_MAX_VALUE_EOK=800.0
LEADER_SEL_MIN_VALUE_FLOOR_EOK=150.0
LEADER_MF_CLAMP_HIGH=1.5
LEAD_ST_W_TURNOVER=0.15
LEADER_SEL_TOP=100
LEADER_VOLFILTER=0.0
LEADER_MAX_SECTORS=3
LEADER_FIB_DYNAMIC=false
REGIME_MA_PERIOD=20
LEAD_ST_W_UPDN=0.45
LEADER_SWITCH_MOVE_MAX_PCT=1.0
LEADER_ANCHOR_EMA=20
LEADER_ENTRY_MODE=vwap_touch
LEADER_SEL_SECTOR_TOP3=true
LEADER_DAILY_TREND_GATE=false
LEADER_MF_CLAMP_LOW=0.5
LEAD_SC_W_INTENSITY=0.65
SCREENER_SECTOR_POS_RATIO_DOWN=0.3
LEADER_FIB_PCT=0.0
REGIME_MOM_DAYS=10
LEADER_SEL_VOL_MULT=2.0
LEAD_ST_W_SURGE=0.2
LEADER_EXIT_MODE=split
LEADER_SPLIT_TP1_PCT=2.0
LEADER_SPLIT_TP1_RATIO=50.0
LEADER_SPLIT_TP2_PCT=4.0
LEADER_TRAIL_ACTIVATE_PCT=4.0
LEADER_TRAIL_GAP_PCT=1.5
LEAD_SCORE_DISP_STOCK_CEIL=0.65
LEAD_SCORE_DISP_SECTOR_CEIL=0.45
LEAD_SCORE_DISP_MAX=100.0

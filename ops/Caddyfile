# 외부 접속용 리버스프록시 (2026-07-16)
# 메인: https://dlsghks6919.duckdns.org:6920 → stock-web:8001 (Basic Auth)
# 폴백: http://<아무주소>:8001 (Basic Auth) — 내부망·비상용
#
# 포트 이력: 8001은 중간 장비(KT 추정)가 TLS 페이로드를 포트 단위로 블랙홀
#   (같은 경로의 6919(NAS)는 정상 통과 — 2026-07-16 비교 실측으로 확정).
#   → NAS 옆 포트 6920 으로 이동. 인증서 갱신(http-01)용으로 80 유지.
# 비밀번호 해시는 파이 로컬 .caddy.env 의 WEB_AUTH_HASH (git 추적 금지)
#   해시 생성: docker run --rm -it caddy:2-alpine caddy hash-password

{
	email lainwhan6919@gmail.com
	servers {
		timeouts {
			# 비정상/엉뚱한 프로토콜 접속은 3초 내 끊어 브라우저 폴백 유도
			read_header 3s
		}
	}
}

# 메인 (https, Let's Encrypt 자동 갱신 — 공유기 80 포워딩 필요)
dlsghks6919.duckdns.org:6920 {
	basic_auth {
		inwhan {$WEB_AUTH_HASH}
	}
	reverse_proxy stock-web:8001 {
		# /api/logs/stream SSE 실시간 스트리밍 유지
		flush_interval -1
	}
}

# 폴백 (평문 http + Basic Auth) — 내부망 IP/도메인 어느 쪽으로도 수신
http://:8001 {
	basic_auth {
		inwhan {$WEB_AUTH_HASH}
	}
	reverse_proxy stock-web:8001 {
		flush_interval -1
	}
}

# 깃에 커밋되는 튜닝 값 (시크릿 금지!)
# docker compose 가 .env 뒤에 이 파일을 로드해서 같은 키는 덮어씀.
# 여기 값을 바꾸고 push → 파이에서 git pull → docker compose up -d 하면 반영.

# ── 캔들 & 실행 주기 ─────────────────────────────────────────────────────────
LIVE_CANDLE=minute
LIVE_INTERVAL_MINUTES=5
NEWS_PAGES_PER_SYMBOL=2

# ── 앙상블 구성 (VWAP 28% / Supertrend 24% / RSI 16% / Bollinger 12% / DailyContext 20%) ──
ENSEMBLE_WEIGHTS=0.28,0.24,0.16,0.12,0.20
ENSEMBLE_MIN_BUY_VOTES=2
ENSEMBLE_BUY_THRESHOLD=0.4
ENSEMBLE_MIN_SELL_VOTES=2
ENSEMBLE_SELL_THRESHOLD=-0.3

# ── 추가매수 설정 ────────────────────────────────────────────────────────────
# 포지션 보유 중 강한 신호 시 소량 추가매수
ADD_BUY_ENABLED=true
ADD_BUY_THRESHOLD=0.45       # 신규매수(0.40)보다 높게 — 강한 신호만
ADD_BUY_MIN_VOTES=2          # 신규매수(2)와 동일
ADD_BUY_MAX_COUNT=2          # 하루 최대 2회
ADD_BUY_FRACTION=0.2         # 계좌 20% (신규매수 40%의 절반)
ADD_BUY_MAX_POSITION_PCT=0.8 # 이미 계좌 80% 이상이면 거부

# ── DailyContext (오버나이트 청산) ────────────────────────────────────────────
# 게이트: 보유일수>=1일 AND 수익>=1.5%
# 플로팅: 세션VWAP+1.5% | 전일고가+1.0% | 전일종가+1.5% (1개 이상)
# 오버나이트 동적 임계값: score<=-0.15 AND 1표 이상
OVERNIGHT_SELL_THRESHOLD=-0.20
OVERNIGHT_MIN_SELL_VOTES=1

# ── VWAP 파라미터 ─────────────────────────────────────────────────────────────

# ── Supertrend 파라미터 ──────────────────────────────────────────────────────
# 25가지 조합 백테스트 최적값: p=7, m=2.5 (샤프 4.05, 수익 +47.88%)
# m=3.0 대비 하락 전환 최대 100분 빠른 인식 (2026-04-30 실데이터 검증)
TRADE_SUPERTREND_PERIOD=7
TRADE_SUPERTREND_MULT=2.5

# ── 포지션 사이징 ─────────────────────────────────────────────────────────────
POSITION_SIZING=fraction
POSITION_FRACTION=0.4   # 계좌의 40%

# ── 뉴스 veto ────────────────────────────────────────────────────────────────
ENSEMBLE_NEWS_VETO_THRESHOLD=-0.6

# ── Claude API 예산 ───────────────────────────────────────────────────────────
API_BUDGET_USD=4.16   # 현재 크레딧 잔액

# ── 뉴스 LLM 감성분석 ────────────────────────────────────────────────────────
NEWS_PREFER_LLM=true   # 신규 기사만 Claude Haiku 분석 (중복은 건너뜀)

# ── 일봉 S/R 필터 ─────────────────────────────────────────────────────────────
SR_ENABLED=false

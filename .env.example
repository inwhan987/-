# 한국투자증권 KIS OpenAPI — 실전 전에 직접 채우세요
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ENV=paper

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 거래 설정
TRADE_SYMBOLS=005930
TRADE_CASH_PER_TRADE=500000
TRADE_STOP_LOSS_PCT=5.0
TRADE_SHORT_MA=5
TRADE_LONG_MA=20

# true = 시뮬레이션 (주문 미전송). 실전 전환 시 false
TRADE_DRY_RUN=true

# 전략: ma_cross | rsi | macd | bollinger | ensemble | news
TRADE_STRATEGY=ensemble
ENSEMBLE_USE_NEWS=true
ENSEMBLE_NEWS_WEIGHT=0.2

# 포지션 사이징: fixed | fraction | atr
POSITION_SIZING=fixed

# 뉴스 크롤링 & 감성 분석 활성화
NEWS_ENABLED=true
NEWS_CRAWL_INTERVAL_MINUTES=30
NEWS_PAGES_PER_SYMBOL=1
NEWS_LOOKBACK_HOURS=24
NEWS_MIN_ARTICLES=3
NEWS_BUY_THRESHOLD=0.3
NEWS_SELL_THRESHOLD=-0.3
NEWS_PREFER_LLM=false

# 웹 대시보드
WEB_HOST=127.0.0.1
WEB_PORT=8001

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

ANTHROPIC_API_KEY=

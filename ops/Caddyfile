# 외부 접속용 리버스프록시 — 평문 http + Basic Auth 최종형 (2026-07-16 확정)
# 접속: http://dlsghks6919.duckdns.org:<외부포트> (공유기에서 외부포트→파이:8001 포워딩)
#       내부망은 http://192.168.0.104:8001
#
# ★ https 절대 금지 — 이 회선(LG U+ 허브/DMZ 이중 NAT)은 "집 안에서 TLS로 응답한
#   포트"를 학습해 그 포트의 TLS 트래픽을 영구 블랙홀 처리함 (2026-07-16 실측:
#   새 포트 18443에 TLS 핸드셰이크 1회 성공 → 수 분 내 블랙홀. 8001·8005 동일 전철.
#   평문으로만 응답한 NAS 6919는 수년째 깨끗). TLS 리스너를 여는 순간 그 포트가
#   오염되어 크롬의 https 승격 시도가 걸려 "사이트에 연결할 수 없음"이 재발한다.
#   크롬이 평문 포트에 https를 찔러도 아래 서버가 즉시 평문 거절 → 바로 http 폴백(NAS와 동일).
#
# 비밀번호 해시는 파이 로컬 .caddy.env 의 WEB_AUTH_HASH (git 추적 금지)
#   해시 생성: docker run --rm -it caddy:2-alpine caddy hash-password
#   compose가 env_file도 변수보간하므로 해시의 '$'는 '$$'로 이스케이프 필수

{
	auto_https off
	servers {
		timeouts {
			# 엉뚱한 프로토콜(TLS 등) 접속은 3초 내 끊어 브라우저 즉시 폴백 유도
			read_header 3s
		}
	}
}

# 호스트명·IP 구분 없이 8001 전부 수신 → 도메인/내부IP 어느 쪽으로도 접속 가능
:8001 {
	basic_auth {
		inwhan {$WEB_AUTH_HASH}
	}
	reverse_proxy stock-web:8001 {
		# /api/logs/stream SSE 실시간 스트리밍 유지
		flush_interval -1
	}
}

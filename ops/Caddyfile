# 외부 접속용 리버스프록시 (2026-07-16)
# http://dlsghks6919.duckdns.org:8001 → stock-web:8001 (Basic Auth)
#
# ⚠ https 미사용 이유: KT 회선이 외부→집 방향 TLS 연결을 DPI로 강제 차단
#   (인증서 발급까지 성공했으나 핸드셰이크가 RST/블랙홀 됨. 2026-07-16 확인)
#   → 평문 http + Basic Auth 로 운영. 비밀번호 해시는 파이 .caddy.env 의 WEB_AUTH_HASH.
#   해시 생성: docker run --rm -it caddy:2-alpine caddy hash-password
{
	email lainwhan6919@gmail.com
	auto_https off
	servers {
		timeouts {
			# 크롬이 http 주소를 https 로 승격 시도하면 TLS 바이트가 이 평문 포트로
			# 들어오는데, 기본값(무제한)은 말없이 대기해 브라우저가 타임아웃까지 멈춤
			# ("사이트에 연결할 수 없음"의 원인). 3초 내 정상 HTTP 요청이 아니면 끊어
			# 크롬이 즉시 http 로 폴백하게 한다. (NAS 6919 포트가 잘 되던 이유 = 즉시 거절)
			read_header 3s
		}
	}
}

# 호스트명·IP 구분 없이 8001 전부 수신 → 도메인/내부IP 어느 쪽으로도 접속 가능
:8001 {
	basic_auth {
		inwhan {$WEB_AUTH_HASH}
	}
	reverse_proxy stock-web:8001 {
		# /api/logs/stream SSE 실시간 스트리밍 유지
		flush_interval -1
	}
}

# 한국투자증권 KIS OpenAPI
# 발급: https://apiportal.koreainvestment.com
KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_ACCOUNT_NO=50123456-01
# 모의투자: paper / 실전: real
KIS_ENV=paper

# 텔레그램 알림 (선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 거래 설정
TRADE_SYMBOLS=005930,000660
TRADE_CASH_PER_TRADE=500000
TRADE_STOP_LOSS_PCT=5.0
TRADE_SHORT_MA=5
TRADE_LONG_MA=20

# true 면 주문 실제로 안 내고 로그만 (검증용). 실전 전에는 유지 권장.
TRADE_DRY_RUN=true

# 전략: ma_cross | rsi
TRADE_STRATEGY=ma_cross
TRADE_RSI_PERIOD=14
TRADE_RSI_OVERSOLD=30
TRADE_RSI_OVERBOUGHT=70

# MACD
TRADE_MACD_FAST=12
TRADE_MACD_SLOW=26
TRADE_MACD_SIGNAL=9

# Bollinger
TRADE_BB_WINDOW=20
TRADE_BB_K=2.0

# 실시간 러너
LIVE_INTERVAL_MINUTES=15
# daily | minute
LIVE_CANDLE=daily
LIVE_MINUTE_INTERVAL=5

# Prometheus metrics 서버 포트 (0 이면 비활성)
METRICS_PORT=0

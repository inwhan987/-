# 깃에 커밋되는 튜닝 값 (시크릿 금지!)
# docker compose 가 .env 뒤에 이 파일을 로드해서 같은 키는 덮어씀.
# 여기 값을 바꾸고 push → 파이에서 git pull → docker compose up -d 하면 반영.

# ── 캔들 & 실행 주기 ─────────────────────────────────────────────────────────
# daily → minute 으로 변경: 5분봉 실시간 신호 계산
LIVE_CANDLE=minute
LIVE_INTERVAL_MINUTES=5

# ── 앙상블 매수/매도 조건 ────────────────────────────────────────────────────
ENSEMBLE_MIN_BUY_VOTES=2
ENSEMBLE_BUY_THRESHOLD=0.4
ENSEMBLE_MIN_SELL_VOTES=2

# ── 포지션 사이징 ─────────────────────────────────────────────────────────────
# fraction: 계좌 총액의 일정 비율로 매수 (복리 효과)
# 종목 1개 기준 20% → 1,000만원 계좌에서 약 200만원/회 매수
POSITION_SIZING=fraction
POSITION_FRACTION=0.2

# ── 뉴스 veto ────────────────────────────────────────────────────────────────
# -0.6: 중립~약한 부정 뉴스에도 매수 허용 (기본 -0.4 보다 완화)
ENSEMBLE_NEWS_VETO_THRESHOLD=-0.6

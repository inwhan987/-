[settings]
; 압축할 대상 폴더 (필수). 예: C:\Users\me\Documents\work
target_folder = C:\변경하세요\대상폴더

; 만들 zip 파일 경로. 비우면 대상폴더 옆에 <폴더이름>.zip 으로 생성
zip_path =

; 압축 시각 (24시간, HH:MM)
zip_time = 18:00

; 해제 시각 (24시간, HH:MM)
unzip_time = 09:10

; 압축 전에 대상 폴더 안에서 열려있는 엑셀 파일을 저장 후 닫기 (true / false)
close_open_excel = true

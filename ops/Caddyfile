# 외부 접속용 리버스프록시 (2026-07-16)
# https://dlsghks6919.duckdns.org → stock-web:8001
# - Let's Encrypt 인증서 자동 발급/갱신 (80 막혀도 443 TLS-ALPN 챌린지로 발급됨)
# - Basic Auth: 해시는 파이 로컬 .caddy.env 의 WEB_AUTH_HASH (git 추적 금지)
#   해시 생성: docker run --rm -it caddy:2-alpine caddy hash-password

{
	email lainwhan6919@gmail.com
	servers {
		# HTTP/3(QUIC, UDP) 광고 끔 — 공유기가 UDP 8001을 안 넘겨줘서
		# 브라우저가 QUIC 시도→실패→폴백 하느라 로딩이 수 초씩 늦어짐
		protocols h1 h2
	}
}

# 접속 주소는 :8001 로 고정(사용자 요청). 443은 인증서 발급 챌린지 전용.
# 포트 없는 https://dlsghks6919.duckdns.org 도 같이 열어둠(둘 다 동작).
dlsghks6919.duckdns.org:8001, dlsghks6919.duckdns.org {
	basic_auth {
		inwhan {$WEB_AUTH_HASH}
	}
	reverse_proxy stock-web:8001 {
		# /api/logs/stream SSE 실시간 스트리밍 유지
		flush_interval -1
	}
}

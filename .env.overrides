# 깃에 커밋되는 튜닝 값 (시크릿 금지!)
# docker compose 가 .env 뒤에 이 파일을 로드해서 같은 키는 덮어씀.
# 여기 값을 바꾸고 push → 파이에서 git pull → docker compose up -d 하면 반영.

# ── 거래 실행 모드 ───────────────────────────────────────────────────────────
TRADE_DRY_RUN=false

# ── 캔들 & 실행 주기 ─────────────────────────────────────────────────────────
LIVE_CANDLE=minute
LIVE_INTERVAL_MINUTES=5
NEWS_PAGES_PER_SYMBOL=2

# ── 앙상블 구성 (VWAP 25% / Supertrend 22% / RSI 20% / Bollinger 18% / DailyContext 15%) ──
ENSEMBLE_WEIGHTS=0.25,0.22,0.20,0.18,0.15
ENSEMBLE_MIN_BUY_VOTES=2
ENSEMBLE_BUY_THRESHOLD=0.50
ENSEMBLE_MIN_SELL_VOTES=2
ENSEMBLE_SELL_THRESHOLD=-0.40

# ── 추가매수 설정 ────────────────────────────────────────────────────────────
# 포지션 보유 중 강한 신호 시 소량 추가매수
ADD_BUY_ENABLED=false
ADD_BUY_THRESHOLD=0.45       # 신규매수(0.40)보다 높게 — 강한 신호만
ADD_BUY_MIN_VOTES=2          # 신규매수(2)와 동일
ADD_BUY_MAX_COUNT=2          # 하루 최대 2회
ADD_BUY_FRACTION=0.2         # 계좌 20% (신규매수 40%의 절반)
ADD_BUY_MAX_POSITION_PCT=0.8 # 이미 계좌 80% 이상이면 거부
ADD_BUY_REQUIRE_TREND_AGREE=true # ST 하락추세면 추가매수 차단 (물타기 방지)
ADD_BUY_INHERIT_INITIAL_STOP=true # 추가매수 시 초기 stop_pct 유지 (손실 폭 제한)

# ── 손절 후 재진입 쿨다운 ────────────────────────────────────────────────────
# 손절 발생 후 N분간 동일 종목 매수 금지 (재진입 사고 방지)
POST_STOPLOSS_COOLDOWN_MIN=30

# ── DailyContext (오버나이트 청산) ────────────────────────────────────────────
# 게이트: 보유일수>=1일 AND 수익>=profit_gate_pct
# 플로팅: 세션VWAP+avwap_pct | 전일고가+pdh_pct | 전일종가+pdc_pct (1개 이상)
# 포지션 없거나 당일 진입이면 DC 가중치 제외 후 나머지 4개에 비례 재분배
OVERNIGHT_SELL_THRESHOLD=-0.20
OVERNIGHT_MIN_SELL_VOTES=1
DAILY_CONTEXT_PROFIT_GATE_PCT=1.5
DAILY_CONTEXT_AVWAP_PCT=1.5
DAILY_CONTEXT_PDH_PCT=1.0
DAILY_CONTEXT_PDC_PCT=1.5
DAILY_CONTEXT_TREND_BONUS=0.5  # ST 상승 중일 때 위 PCT 값에 더하는 가산값

# ── VWAP 파라미터 ─────────────────────────────────────────────────────────────
# 0.007 → 0.0085: 상승장 VWAP 추격 오신호 감소 (2026-05-06 리뷰 반영)
TRADE_VWAP_BAND=0.008
# 매도 이탈 기준 (0이면 TRADE_VWAP_BAND와 동일)
TRADE_VWAP_SELL_BAND=0.0085
# 슈퍼트렌드 상승추세 시 매도 기준 (0이면 TRADE_VWAP_SELL_BAND와 동일)
TRADE_VWAP_ST_BULL_SELL_BAND=0.009
# 워밍업 12봉(60분) → 8봉(40분): 진입차단(09:40)과 시점 동기화
# 백테스트: 8봉이 +36.94%로 12봉(+36.88%)과 동등 또는 미세 개선
TRADE_VWAP_WARMUP_BARS=8

# ── RSI 파라미터 ─────────────────────────────────────────────────────────────
# period 34→21 복원: KIS 당일분봉 최대 30봉 반환 → 34기간 시 36봉 필요로 신호 불가
# overbought 72→74: 경계값 오류·조기 매도 방지 (2026-05-06 리뷰 반영)
# ※ 2026-05-08 재확인: KIS API 슬라이딩 윈도우 30봉 한계 실측 완료
# ※ 2026-05-08 21→25 상향: 노이즈 감소 목적, 27봉 필요 → KIS 30봉 내 여유 3봉
TRADE_RSI_PERIOD=25
TRADE_RSI_OVERSOLD=30
TRADE_RSI_OVERBOUGHT=74.0

# ── Supertrend 파라미터 ──────────────────────────────────────────────────────
# 25가지 조합 백테스트 최적값: p=7, m=2.5 (샤프 4.05, 수익 +47.88%)
# m=3.0 대비 하락 전환 최대 100분 빠른 인식 (2026-04-30 실데이터 검증)
TRADE_SUPERTREND_PERIOD=7
TRADE_SUPERTREND_MULT=2.5

# ── 포지션 사이징 ─────────────────────────────────────────────────────────────
POSITION_SIZING=fraction
POSITION_FRACTION=0.7   # 계좌의 70% (단일 종목 운영 + 추가매수 OFF)

# ── ATR 동적 손절 ─────────────────────────────────────────────────────────────
# 변동성 기반 손절 거리. 변동성 큰 날엔 손절 멀어짐(추세 끝까지) / 작은 날엔 가까워짐
# 5분봉 ATR(14) × 12 ≈ 1.5~2.5% 손절선 (백테스트 80% 승률, 샤프 3.21)
# ※ ×8은 너무 타이트(잡손절 빈발), ×12가 최적
ATR_STOP_LOSS_ENABLED=true
ATR_PERIOD=14
ATR_STOP_MULTIPLIER=12.0
ATR_STOP_MAX_PCT=5.0

# ── 시간대 차단 (장초반 변동성 회피) ──────────────────────────────────────────
# 09:00~09:40 동안:
#   - 수익률 ≥ ENTRY_BLOCK_MIN_PROFIT_TO_SELL_PCT 면 분할 강제매도 (앙상블 무관)
#     · 잔량 보존 비율: ENTRY_BLOCK_FORCE_SELL_FRACTION (0.5 = 50% 매도)
#     · 하루 1회만 발동 (잔량은 09:40 이후 일반 로직)
#   - BUY (신규/추가매수): 차단 (장초반 진입 위험 회피)
#   - SELL (일반/stop_loss): 모두 통과 (앙상블 결정 신뢰, 진짜 하락 신호 놓치지 않음)
ENTRY_BLOCK_ENABLED=true
ENTRY_BLOCK_START=09:00
ENTRY_BLOCK_END=09:40
ENTRY_BLOCK_MIN_PROFIT_TO_SELL_PCT=2.0
ENTRY_BLOCK_FORCE_SELL_FRACTION=0.5

# ── 거래량 필터 (가짜 돌파 차단) ──────────────────────────────────────────────
# 점수 가산/감산 모드 — 6종목 백테스트 평균 +1.3%p 개선 (2026-05-10)
# 매수 우세 + 거래량≥1.2배 → score +0.10 (강화)
# 매수 우세 + 거래량≤0.7배 → score -0.05 (약화, 가짜 돌파 가능성)
# 매도 시는 반대 방향 적용
ENSEMBLE_VOLUME_FILTER_ENABLED=true
ENSEMBLE_VOLUME_MA_PERIOD=20
ENSEMBLE_VOLUME_HIGH_RATIO=1.2
ENSEMBLE_VOLUME_LOW_RATIO=0.7
ENSEMBLE_VOLUME_SCORE_BOOST=0.10
ENSEMBLE_VOLUME_SCORE_PENALTY=0.05

# ── 뉴스 veto ────────────────────────────────────────────────────────────────
ENSEMBLE_NEWS_VETO_THRESHOLD=-0.6
# 강한 부정 기사 비율 (sentiment_score <= veto_threshold) ≥ 10%면 매수 거부
# (2026-05-06 리뷰: -0.7 기사 1건이 78개 평균에 희석되던 구조 보완)
ENSEMBLE_NEWS_STRONG_NEG_RATIO=0.10

# ── Claude API 예산 ───────────────────────────────────────────────────────────
API_BUDGET_USD=4.16   # 현재 크레딧 잔액

# ── 뉴스 LLM 감성분석 ────────────────────────────────────────────────────────
NEWS_PREFER_LLM=true   # 신규 기사만 Claude Haiku 분석 (중복은 건너뜀)

# ── 일봉 S/R 필터 ─────────────────────────────────────────────────────────────
SR_ENABLED=false

# ── 성과 측정 초기자금 (웹 UI에서도 수정 가능) ────────────────────────────────
INITIAL_CAPITAL_KRW=10000000
# 성과 계산 시작일 — 이 날짜 이전 거래는 FIFO에서 제외 (테스트 거래 스킵용)
PERF_START_DATE=2026-04-27
# 거래 수수료율 (웹 UI에서도 수정 가능)
TRADE_FEE_BUY_PCT=0.00015
TRADE_FEE_SELL_PCT=0.00195

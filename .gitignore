__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
!.env.overrides
!.env.example
.kis_tokens/
.claude/settings.local.json
db/
*.db
*.sqlite
.DS_Store
.pytest_cache/
logs/
*.log
build/
dist/
*.egg-info/

# DB 백업 CSV (자동 생성, git 추적 대상)
# NOTE: 예전엔 여기 `!data/` 가 있었으나, 그게 data/ 전체를 무시-해제로 강제해
# 아래의 개별 무시 규칙(charts/leader_picks/.kis_rate_gate 등)을 전부 무력화했다.
# 그래서 런타임 파일이 계속 추적돼 파이 라이브 쓰기 ↔ pull 이 rebase 충돌을 냈다.
# `!data/` 제거 → 개별 규칙이 정상 작동(아래 `!data/...` 예외는 그대로 유지).
!data/*.csv
!data/backup_log.txt
!data/news/
!data/news/*.csv

# 웹 UI 백테스트 히스토리 (자주 갱신, gitignore 처리)
data/backtest_history.json
# update.sh 빌드 해시 (런타임 생성, 커밋 불필요)
data/.last_build_hash
# KIS 유량 게이트 (모든 KIS 호출마다 갱신되는 런타임 파일 — 절대 추적 금지)
data/.kis_rate_gate
# 대장주봇 매매 상태 (런타임 생성, 봇이 덮어씀)
data/leader_trade_state/
# 스크리너 런타임 파일
data/screener_last_run.txt
# 대장주 테마 구성종목 캐시 — 09:05 프리페치가 매일 새로 만드는 런타임 파일(~64KB).
# 날짜 키라 다음날 자동 폐기 = 백업 가치 0. 추적하면 매일 전체 내용이 교체돼
# 파이 백업 커밋마다 64KB churn + pull 충돌 위험만 는다.
data/leader_theme_cache.json
# DART 재무 디스크 캐시 (런타임 생성, 7일 TTL)
data/dart_fin_cache.json
# OpenDartReader corp_codes 캐시 (스크리너 subprocess CWD=data/ 에 생성)
data/docs_cache/
# 스크리너 최신 실행 로그 (런타임 생성)
data/screener_latest.log
# LLM 문구 캐시 (런타임 생성)
data/llm_phrases_*.json
# 봇/웹/대장주 로그: 누적 라이브 로그(stock_bot.log 등)는 *.log 전역 규칙으로 무시.
# 백업이 만드는 날짜별 스냅샷(data/logs/{bot,web,leader}/YYYY-MM-DD.log)만 추적 —
# 한 번 쓰고 다신 안 바뀌어 churn/rebase 충돌이 없다(news/screener 백업과 동일 방식).
!data/logs/
!data/logs/**/2[0-9][0-9][0-9]-*.log
# 대장주 5일평균 거래대금 캐시 (런타임 생성, 일 1회 갱신)
data/leader_avgval_cache.json
# 대장주 일별 선별 결과 — 날짜별 파일만 백업 커밋 대상 (2026-08-18).
# 정본(YYYY-MM-DD.json)은 09:2x 선별 후, 재선별본(_reval.json)은 13시 전환창이
# 닫힌 후 더 안 바뀐다 → 백업(00:05 KST) 시점엔 write-once 라 data/logs 스냅샷과
# 동일하게 churn/rebase 충돌이 없다. 파일당 ~2~5KB.
# 백테스트 3종(backtest_leader_pullback*.py, score_leader_picks.py)이 이 파일을
# 읽으므로, 추적 안 하면 파이 SD 유실 = 전진검증 표본 전멸.
data/leader_picks/
!data/leader_picks/
!data/leader_picks/2[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].json
!data/leader_picks/2[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]_reval.json
# 수동 임시 휴장일 (웹 파라미터 탭에서 편집, 런타임 생성)
data/extra_holidays.json
# 차트 표시용 봉 스냅샷 — 봇이 매 tick 덮어쓰는 런타임 파일.
# 추적하면 파이 봇의 라이브 쓰기 ↔ pull 이 충돌해 rebase 가 굳는다(백업 가치 없음).
data/charts/
# 스크리너 날짜별 실행 로그 — 백업 커밋 대상 (전역 *.log 무시 예외)
!data/screener/
!data/screener/*.log
# 포지션 소유권 코디네이션 (봇 런타임 갱신, 추적 금지)
data/coord/
# Caddy 리버스프록시 — 비밀번호 해시·TLS 개인키 절대 추적 금지
.caddy.env
data/caddy/
data/caddy_config/
